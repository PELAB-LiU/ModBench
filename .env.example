# Copy this file to `.env` and adjust values for your deployment.
# `.env` is gitignored and must NOT be committed.

# ---------------------------------------------------------------------------
# GitHub API
# ---------------------------------------------------------------------------
# Personal access token used by access/api.py to fetch commit / PR / issue
# metadata. Optional; without it the API uses unauthenticated requests
# (subject to GitHub's lower rate limits).
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Remote dataset server (optional)
# ---------------------------------------------------------------------------
# When set, reports.py and access/api.py can read the pipeline databases
# and canonical files from a remote machine over SSH instead of locally.

# Set to 1 to make reports.py query the remote databases via SSH.
USE_REMOTE=0

# SSH host alias (must be resolvable by `ssh <host>` on this machine).
REMOTE_HOST=
# Base path on the remote machine that contains `dataset/...` and
# `canonical_models/...` directories.
REMOTE_BASE=

# Same host/base, but used by the Access API's on-demand canonical-file
# fallback (access/api.py). Usually identical to REMOTE_HOST / REMOTE_BASE
# above; kept separate so reports and runtime fetches can target different
# machines if needed.
CANONICAL_REMOTE_HOST=
CANONICAL_REMOTE_BASE=

# ---------------------------------------------------------------------------
# Local overrides (optional)
# ---------------------------------------------------------------------------
# Where to find cloned Modelica source repos for git date resolution in
# reports.py. Defaults to ./source relative to reports.py.
# LOCAL_SOURCE_DIR=

# Override the on-disk root of canonical .mo files. Defaults to
# ./dataset/canonical_models inside this project.
# CANONICAL_LOCAL_BASE=


# Optional: .tex file (or directory of .tex files) of the slide deck, used
# to check which variables.tex macros the slides reference. When unset, all
# macros are treated as slide-referenced.
# SLIDES_SECTION_PATH=

# Optional: directory receiving generated paper artifacts (variables.tex and
# figs/). When unset, outputs are written to this project root.
# PAPER_DIR=
